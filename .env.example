# Optional public browser configuration overrides. Project defaults are in lib/supabase/client.ts.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
# Never use a service-role or secret key here.

# Server-only subscription credentials. Do not prefix these with NEXT_PUBLIC_.
# Checkout stays disabled until all required Stripe variables are configured.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Public canonical website origin used for secure checkout return URLs.
NEXT_PUBLIC_APP_URL=https://sprout-trading.vercel.app

# Server-only Sprouty AI + web search. Library answers work without this.
OPENAI_API_KEY=
SPROUTY_MODEL=gpt-4.1-mini

# Optional public support email shown on policy and support pages.
# NEXT_PUBLIC_SUPPORT_EMAIL=
